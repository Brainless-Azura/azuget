# Les fichiers du flux sont signés octet par octet : aucune conversion de fin de ligne.
docs/** -text
*.json -text
*.sig -text
# Scripts destinés aux Pi : fins de ligne Unix
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.path text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.zip binary
*.png binary
